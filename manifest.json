{
    "name": "It's Raining"
    ,"version":"3.0"
    ,"manifest_version":3
    ,"description":"Rain Makes Everything Better"

    ,"icons":{
        "16":"assets/16.png"
        ,"48":"assets/48.png"
        ,"128":"assets/128.png"
    }
    ,"action": {
        "default_icon": "assets/sun.png"
        ,"default_title":"Raining makes everything better!"
    }
    ,"permissions":[
        "offscreen"
    ]

    ,"options_ui": {
        "page": "options.html"
    }
    ,"background": {
        "service_worker": "background.js"
    }
}
